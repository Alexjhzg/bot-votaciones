# ==============================================================
# .env.example — Configuración para Bot de Consulta de Votaciones
# ==============================================================

# Token del bot proporcionado por @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGHIjklMNOpqrsTUVwxyz

# ID de la hoja de Google Sheets que contiene la nómina (SEGEN e INE)
# Corresponde a la cadena alfanumérica en la URL entre /d/ y /edit
GOOGLE_SPREADSHEET_ID=1ZD57WTZMseTWIWqPriXobLe3imESwKnBhqGpfxXE99A

# Credenciales de la cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=telegram@telegram-496916.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Pestañas a leer dentro de la hoja de cálculo (separadas por coma)
# Si se deja vacío, buscará en todas las pestañas disponibles
GOOGLE_SHEET_TABS=SEGEN,INE,nomina

# Zona horaria para el registro de fecha y hora
TIMEZONE=America/Caracas

# Puerto para el servidor HTTP de healthcheck (Keep-alive en Render / Railway)
PORT=8080
